+    JAVA_HOME="$BREW_JDK/libexec/openjdk.jdk/Contents/Home"
+  elif [[ -n "$BREW_JDK" && -x "$BREW_JDK/bin/java" ]]; then
+    JAVA_HOME="$BREW_JDK"
+  fi
+fi
+if [[ -n "$JAVA_HOME" && -x "$JAVA_HOME/bin/java" ]]; then
+  printf 'Java: '
+  "$JAVA_HOME/bin/java" -version 2>&1 | head -n 1
+  printf 'Java home: %s\n' "$JAVA_HOME"
+elif command -v java >/dev/null 2>&1; then
+  printf 'Java: '
+  java -version 2>&1 | head -n 1
+  printf 'Java home: %s\n' "$(/usr/libexec/java_home 2>/dev/null || echo 'not registered with java_home')"
+else
+  echo 'Java: not found'
