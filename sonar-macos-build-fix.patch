@@ -6,10 +6,35 @@
 printf 'macOS: '; sw_vers -productVersion 2>/dev/null || true
 printf 'Build: '; sw_vers -buildVersion 2>/dev/null || true
 printf 'Architecture: '; uname -m
-printf 'Java: '; java -version 2>&1 | head -n 1 || true
-printf 'Java home: '; /usr/libexec/java_home -v 17 2>/dev/null || echo 'JDK 17 not found'
+JAVA_HOME="$(/usr/libexec/java_home -v 17 2>/dev/null || true)"
+if [[ -z "$JAVA_HOME" ]] && command -v brew >/dev/null 2>&1; then
+  BREW_JDK="$(brew --prefix openjdk@17 2>/dev/null || true)"
